{% assign m = include.member %}
{% assign variant = include.variant | default: 'regular' %}

<div class="member-card member-card--{{ variant }}" id="member-{{ m.id }}">
  <div class="member-card__avatar-wrapper">
    {% if m.photo and m.photo != '' %}
      <img src="{{ m.photo | relative_url }}" alt="{{ m.name_en }}" class="member-card__avatar" loading="lazy">
    {% else %}
      {% assign name_parts = m.name_en | split: ' ' %}
      <div class="member-card__avatar member-card__avatar--placeholder" aria-hidden="true">
        <span>
          {{- name_parts.first | slice: 0, 1 -}}
          {{- name_parts.last | slice: 0, 1 -}}
        </span>
      </div>
    {% endif %}
  </div>

  <div class="member-card__content">
    <h3 class="member-card__name">
      {{ m.name_ko }}
      <span class="member-card__name-en">{{ m.name_en }}</span>
    </h3>

    <div class="member-card__role">
      {% if variant == 'pi' %}
        <span class="member-role">
          {{- m.title_ko -}}
          <span class="member-role__sep">·</span>{{ m.title_en -}}
        </span>
      {% else %}
        <span class="member-role">{{ m.role_ko }}</span>
        {% if m.degree_program %}
          <span class="member-role__sep" aria-hidden="true">·</span>
          <span class="member-program" style="font-size: var(--tm-fs-2xs); color: var(--tm-muted);">{{ m.degree_program }}</span>
        {% endif %}
      {% endif %}
    </div>

    {% if variant == 'pi' %}
      {% if m.office or m.phone %}
        <div
          class="member-card__contact"
          style="margin-top: var(--tm-s2); font-size: var(--tm-fs-xs); color: var(--tm-muted); display: flex; flex-wrap: wrap; gap: var(--tm-s3);"
        >
          {% if m.office -%}
            <span><i class="fa-solid fa-location-dot" style="color: var(--tm-faint); margin-right: 4px;"></i>{{ m.office }}</span>
          {%- endif %}
          {% if m.phone -%}
            <span><i class="fa-solid fa-phone" style="color: var(--tm-faint); margin-right: 4px;"></i>{{ m.phone }}</span>
          {%- endif %}
        </div>
      {% endif %}
      {% if m.bio and m.bio != '' %}
        <p class="member-card__bio">{{ m.bio }}</p>
      {% endif %}
    {% else %}
      {% if m.project and m.project != '' %}
        <div class="member-card__project" style="margin-top: var(--tm-s2); font-size: var(--tm-fs-xs); color: var(--tm-text);">
          <i class="fa-solid fa-flask" style="color: var(--tm-faint); margin-right: 4px;"></i>{{ m.project }}
        </div>
      {% endif %}
      {% if m.office and m.office != '' %}
        <div class="member-card__office" style="margin-top: 2px; font-size: var(--tm-fs-2xs); color: var(--tm-muted);">
          <i class="fa-solid fa-location-dot" style="color: var(--tm-faint); margin-right: 4px;"></i>{{ m.office }}
        </div>
      {% endif %}
      {% if m.awards and m.awards.size > 0 %}
        <div class="member-card__award" style="margin-top: 4px; font-size: var(--tm-fs-2xs); color: #d97706; font-weight: 500;">
          <i class="fa-solid fa-award" style="margin-right: 4px;"></i>{{ m.awards.first }}
        </div>
      {% endif %}
    {% endif %}

    {% if m.topics and m.topics.size > 0 %}
      <div class="member-card__topics">
        {% for t in m.topics %}
          <span class="topic-tag">{{ t }}</span>
        {% endfor %}
      </div>
    {% endif %}

    {% assign member_email = m.links.email | default: m.email %}
    {% if m.links or member_email != '' %}
      <div class="member-card__links">
        {% if member_email and member_email != '' %}
          <a href="mailto:{{ member_email }}" title="Email ({{ member_email }})" aria-label="Email" class="link-icon"
            ><i class="fa-solid fa-envelope"></i
          ></a>
        {% endif %}
        {% if m.links.scholar and m.links.scholar != '' %}
          <a href="{{ m.links.scholar }}" target="_blank" rel="noopener" title="Google Scholar" aria-label="Google Scholar" class="link-icon"
            ><i class="ai ai-google-scholar"></i
          ></a>
        {% endif %}
        {% if m.links.orcid and m.links.orcid != '' %}
          <a href="{{ m.links.orcid }}" target="_blank" rel="noopener" title="ORCID" aria-label="ORCID" class="link-icon"
            ><i class="ai ai-orcid"></i
          ></a>
        {% endif %}
        {% if m.links.researchgate and m.links.researchgate != '' %}
          <a href="{{ m.links.researchgate }}" target="_blank" rel="noopener" title="ResearchGate" aria-label="ResearchGate" class="link-icon"
            ><i class="ai ai-researchgate"></i
          ></a>
        {% endif %}
        {% if m.links.github and m.links.github != '' %}
          <a href="{{ m.links.github }}" target="_blank" rel="noopener" title="GitHub" aria-label="GitHub" class="link-icon"
            ><i class="fa-brands fa-github"></i
          ></a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>
