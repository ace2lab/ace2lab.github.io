{% comment %}
  Student / researcher card. Co-PIs use pi_profile.liquid instead.
{% endcomment %}
{% assign m = include.member %}
{% assign variant = include.variant | default: 'regular' %}

{% comment %} Achievement total (papers + patents + awards + talks matched by Korean name); the popup content is rendered in members.md. {% endcomment %}
{% assign ach_papers = site.data.student_papers | where_exp: 'x', 'x.members contains m.name_ko' %}
{% assign ach_patents = site.data.patents | where_exp: 'x', 'x.inventors contains m.name_ko' %}
{% assign ach_awards = site.data.awards | where_exp: 'x', 'x.recipient contains m.name_ko' %}
{% assign ach_talks = site.data.talks | where_exp: 'x', 'x.presenters contains m.name_ko' %}
{% assign ach_total = ach_papers.size | plus: ach_patents.size | plus: ach_awards.size | plus: ach_talks.size %}

{% comment %} Degree-program role key drives the semantic colour (see team_grid.css §3b). {% endcomment %}
{% case m.role_ko %}
  {% when '박사과정', '석박통합과정' %}
    {% assign role_key = 'phd' %}
  {% when '석사과정', '학연과정(석사)' %}
    {% assign role_key = 'ms' %}
  {% when '연구원', '연구원(석사)' %}
    {% assign role_key = 'researcher' %}
  {% when '학부연구생' %}
    {% assign role_key = 'undergrad' %}
  {% else %}
    {% assign role_key = 'other' %}
{% endcase %}

<div class="member-card member-card--{{ variant }}" id="member-{{ m.id }}" data-role="{{ role_key }}">
  {% if m.role_ko and m.role_ko != '' %}
    {% assign en_role_short = 'Member' %}
    {% case role_key %}
      {% when 'phd' %}
        {% assign en_role_short = 'Ph.D. Student' %}
      {% when 'ms' %}
        {% assign en_role_short = 'M.S. Student' %}
        {% if m.role_ko == '학연과정(석사)' %}
          {% assign en_role_short = 'M.S. Student (Joint)' %}
        {% endif %}
      {% when 'researcher' %}
        {% assign en_role_short = 'Researcher' %}
        {% if m.role_ko == '연구원(석사)' %}
          {% assign en_role_short = 'Researcher (M.S.)' %}
        {% endif %}
      {% when 'undergrad' %}
        {% assign en_role_short = 'Undergrad' %}
    {% endcase %}
    <div class="member-card__role-banner">
      <span class="member-card__role-title"> <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i> {{ m.role_ko }} </span>
      <span class="member-card__role-en">{{ en_role_short }}</span>
    </div>
  {% endif %}

  <div class="member-card__avatar-wrapper">
    {% if m.photo and m.photo != '' %}
      <img src="{{ m.photo | relative_url }}" alt="{{ m.name_en }}" class="member-card__avatar" loading="lazy" decoding="async">
    {% else %}
      {% assign name_parts = m.name_en | split: ' ' %}
      <div class="member-card__avatar member-card__avatar--placeholder" aria-hidden="true">
        <span>
          {{- name_parts.first | slice: 0, 1 -}}
          {{- name_parts.last | slice: 0, 1 -}}
        </span>
      </div>
    {% endif %}
  </div>

  <div class="member-card__content">
    <div class="member-card__role">
      <span class="member-badge member-badge--{{ role_key }}">{{ m.role_ko }}</span>
      {% if m.degree_program %}
        {% assign program_parts = m.degree_program | split: ' (' %}
        {% if program_parts.size > 1 %}
          <span class="member-card__period">{{ program_parts[1] | replace: ')', '' }}</span>
        {% endif %}
      {% endif %}
    </div>

    <h3 class="member-card__name">
      {{ m.name_ko }}
      <span class="member-card__name-en">{{ m.name_en }}</span>
    </h3>

    {% comment %} Fixed 4-row metadata: affiliation → education → research field → office. {% endcomment %}
    {% assign research_field = m.research_field | default: m.project %}
    {% if m.affiliation != blank or m.education != blank or research_field != blank or m.office != blank %}
      <ul class="member-meta" role="list">
        {% if m.affiliation != blank %}
          <li class="member-meta__affiliation">
            <i class="fa-solid fa-building-columns" aria-hidden="true"></i><span><span class="tm-sr-only">현재 소속: </span>{{ m.affiliation }}</span>
          </li>
        {% endif %}
        {% if m.education != blank %}
          <li class="member-meta__edu">
            <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
            <span class="member-meta__edu-wrap">
              <span class="tm-sr-only">학력: </span>
              {%- if m.education.first -%}
                {%- for item in m.education -%}
                  <span class="member-meta__edu-line">
                    {%- if item contains " ('" -%}
                      {{ item | replace: " ('", "&nbsp;<span class=\"tm-nb\">('" | append: "</span>" }}
                    {%- else -%}
                      {{ item | escape }}
                    {%- endif -%}
                  </span>
                {%- endfor -%}
              {%- else -%}
                <span class="member-meta__edu-line">
                  {%- if m.education contains " ('" -%}
                    {{ m.education | replace: " ('", "&nbsp;<span class=\"tm-nb\">('" | append: "</span>" }}
                  {%- else -%}
                    {{ m.education | escape }}
                  {%- endif -%}
                </span>
              {%- endif -%}
            </span>
          </li>
        {% endif %}
        {% if research_field != blank %}
          <li class="member-meta__research">
            <i class="fa-solid fa-flask" aria-hidden="true"></i><span><span class="tm-sr-only">연구분야: </span>{{ research_field }}</span>
          </li>
        {% endif %}
        {% if m.office != blank %}
          <li class="member-meta__muted">
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i><span><span class="tm-sr-only">위치: </span>{{ m.office }}</span>
          </li>
        {% endif %}
      </ul>
    {% endif %}

    {% assign member_email = m.links.email | default: m.email %}
    {% if m.links or member_email != '' or ach_total > 0 %}
      <div class="member-card__links">
        {% if member_email and member_email != '' %}
          <a href="mailto:{{ member_email }}" title="Email ({{ member_email }})" aria-label="Email" class="link-icon"
            ><i class="fa-solid fa-envelope" aria-hidden="true"></i
          ></a>
        {% endif %}
        {% if m.links.scholar and m.links.scholar != '' %}
          <a href="{{ m.links.scholar }}" target="_blank" rel="noopener" title="Google Scholar" aria-label="Google Scholar" class="link-icon"
            ><i class="ai ai-google-scholar" aria-hidden="true"></i
          ></a>
        {% endif %}
        {% if m.links.orcid and m.links.orcid != '' %}
          <a href="{{ m.links.orcid }}" target="_blank" rel="noopener" title="ORCID" aria-label="ORCID" class="link-icon"
            ><i class="ai ai-orcid" aria-hidden="true"></i
          ></a>
        {% endif %}
        {% if m.links.researchgate and m.links.researchgate != '' %}
          <a href="{{ m.links.researchgate }}" target="_blank" rel="noopener" title="ResearchGate" aria-label="ResearchGate" class="link-icon"
            ><i class="ai ai-researchgate" aria-hidden="true"></i
          ></a>
        {% endif %}
        {% if m.links.github and m.links.github != '' %}
          <a href="{{ m.links.github }}" target="_blank" rel="noopener" title="GitHub" aria-label="GitHub" class="link-icon"
            ><i class="fa-brands fa-github" aria-hidden="true"></i
          ></a>
        {% endif %}
        {% if ach_total > 0 %}
          <button type="button" class="member-card__ach-btn" data-ach-target="ach-{{ m.id }}" data-ach-name="{{ m.name_ko }}" aria-haspopup="dialog">
            <i class="fa-solid fa-award" aria-hidden="true"></i><span>연구 실적 · {{ ach_total }}</span>
          </button>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>
