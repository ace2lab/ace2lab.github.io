{% comment %}
  al_folio_core bib.liquid hook: appends funding acknowledgment and press coverage to the periodical block.
  Journal and date are folded into entrytype so the funding/press blocks follow them instead of the date.
{% endcomment %}
{% assign journal_meta = site.data.journals[entry.journal] %}
{% if journal_meta or entry.funding or entry.press %}
  {% capture entrytype %}{{ entrytype }}{{ entrymonth }}{{ entryyear }}{% endcapture %}
  {% assign entrymonth = '' %}
  {% assign entryyear = '' %}
  {% if journal_meta %}
    {% capture entrytype %}{{ entrytype }}<div class="ed-entry__jcr"><span class="pub-badge {{ journal_meta.badge_class }}"><i class="fa-solid fa-trophy" aria-hidden="true"></i> {{ journal_meta.badge_label }}</span></div>{% endcapture %}
  {% endif %}
  {% if entry.funding %}
    {% capture entrytype %}{{ entrytype }}<div class="ed-entry__funding"><span class="ed-label">Funding</span>{{ entry.funding | escape }}</div>{% endcapture %}
  {% endif %}
  {% if entry.press %}
    {% capture entrytype %}{{ entrytype }}<div class="ed-entry__press"><a href="{{ entry.press }}" target="_blank" rel="noopener" class="ed-pill ed-pill--press"{% if entry.press_title %} title="{{ entry.press_title | escape }}"{% endif %}><i class="fa-solid fa-newspaper" aria-hidden="true"></i> 언론보도 ({{ entry.press_media | default: '기사' | escape }}) <i class="fa-solid fa-arrow-up-right-from-square ed-ext-icon" aria-hidden="true"></i></a>{% if entry.press_naver %}<a href="{{ entry.press_naver }}" target="_blank" rel="noopener" class="ed-pill ed-pill--naver" title="네이버 뉴스 검색결과 바로가기"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> 네이버 뉴스 <i class="fa-solid fa-arrow-up-right-from-square ed-ext-icon" aria-hidden="true"></i></a>{% endif %}</div>{% endcapture %}
  {% endif %}
{% endif %}
