{% comment %}
  al_folio_core bib.liquid hook: appends funding acknowledgment and press coverage to the periodical block.
  Journal and date are folded into entrytype so the funding/press blocks follow them instead of the date.
{% endcomment %}
{% assign clean_journal = entry.journal | replace: '&amp;', '&' %}
{% assign journal_meta = site.data.journals[clean_journal] %}
{% comment %}
  Front Cover badge: bound to _data/covers.yml (key = BibTeX key). A `note` containing "Front Cover" also qualifies,
  so an accepted cover whose art is still pending keeps its badge until the image is added to covers.yml.
{% endcomment %}
{% assign cover_meta = site.data.covers | where: 'key', entry.key | first %}
{% assign is_cover = false %}
{% if cover_meta or entry.note contains 'Front Cover' %}
  {% assign is_cover = true %}
{% endif %}
{% if journal_meta or entry.funding or entry.press or is_cover %}
  {% capture date_part %}{{ entrymonth }}{{ entryyear }}{% endcapture %}
  {% assign date_part_clean = date_part | strip %}
  {% if date_part_clean != '' %}
    {% capture entrytype %}{{ entrytype }}, {{ date_part_clean }}{% endcapture %}
  {% endif %}
  {% assign entrymonth = '' %}
  {% assign entryyear = '' %}
  {% assign badge_label = journal_meta.badge_label %}
  {% if badge_label == null and journal_meta.top_pct and journal_meta.if %}
    {% capture badge_label %}JCR Top {{ journal_meta.top_pct }}% · IF {{ journal_meta.if }}{% endcapture %}
  {% endif %}
  {% if badge_label or is_cover %}
    {% assign badge_css = journal_meta.badge_class | default: journal_meta.class | default: 'pub-badge--jcr' %}
    {% capture entrytype %}{{ entrytype }} <div class="ed-entry__badges">{% if badge_label %}<span class="pub-badge {{ badge_css }}"><i class="fa-solid fa-trophy" aria-hidden="true"></i> {{ badge_label }}</span>{% endif %}{% if is_cover %}<span class="pub-badge pub-badge--cover"><i class="fa-solid fa-award" aria-hidden="true"></i> <span data-i18n="publications.badge_front_cover">Front Cover</span></span>{% endif %}</div>{% endcapture %}
  {% endif %}
  {% if entry.funding %}
    {% capture entrytype %}{{ entrytype }}<div class="ed-entry__funding"><span class="ed-label">Funding</span>{{ entry.funding | escape }}</div>{% endcapture %}
  {% endif %}
  {% if entry.press %}
    {% capture entrytype %}{{ entrytype }}<div class="ed-entry__press"><a href="{{ entry.press }}" target="_blank" rel="noopener" class="ed-pill ed-pill--press"{% if entry.press_title %} title="{{ entry.press_title | escape }}"{% endif %}><i class="fa-solid fa-newspaper" aria-hidden="true"></i> 언론보도 ({{ entry.press_media | default: '기사' | escape }}) <i class="fa-solid fa-arrow-up-right-from-square ed-ext-icon" aria-hidden="true"></i></a>{% if entry.press_naver %}<a href="{{ entry.press_naver }}" target="_blank" rel="noopener" class="ed-pill ed-pill--naver" title="네이버 뉴스 검색결과 바로가기"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> 네이버 뉴스 <i class="fa-solid fa-arrow-up-right-from-square ed-ext-icon" aria-hidden="true"></i></a>{% endif %}</div>{% endcapture %}
  {% endif %}
{% endif %}
