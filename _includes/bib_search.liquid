{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  <input
    type="text"
    id="bibsearch"
    spellcheck="false"
    autocomplete="off"
    class="search bibsearch-form-input"
    data-i18n-placeholder="publications.search_placeholder"
    placeholder="논문 제목, 저자명, 학술지명 또는 키워드로 검색 (영문)..."
  >
{% endif %}
