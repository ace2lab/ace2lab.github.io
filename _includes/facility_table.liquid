<div class="ed-spec ed-spec--with-thumbs" role="table" aria-label="{{ include.caption | escape }}">
  <div class="ed-spec__head" role="row">
    <span role="columnheader"><i class="fa-solid fa-camera" aria-hidden="true"></i> Photo</span>
    <span role="columnheader"><i class="fa-solid fa-microscope" aria-hidden="true"></i> Instrument</span>
    <span role="columnheader"><i class="fa-solid fa-industry" aria-hidden="true"></i> Manufacturer · Model</span>
    <span role="columnheader" class="text-end"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Location</span>
  </div>
  {% for item in include.items %}
    {%- case item.location -%}
      {%- when '7호관 403호' -%}
        {%- assign room_key = 'r403' -%}
      {%- when '7호관 414호' -%}
        {%- assign room_key = 'r414' -%}
      {%- when '8호관 313호' -%}
        {%- assign room_key = 'r313' -%}
      {%- else -%}
        {%- assign room_key = 'none' -%}
    {%- endcase -%}
    <div class="ed-spec__row" role="row" id="fac-{{ item.id }}" data-room="{{ room_key }}">
      <div class="ed-spec__thumb" role="cell">
        {% if item.img and item.img != '' %}
          <img
            src="{{ item.img | relative_url }}"
            alt="{{ item.name | escape }}"
            loading="lazy"
            data-zoomable
          >
        {% else %}
          <div class="ed-spec__thumb--placeholder"><i class="fa-solid fa-microscope" aria-hidden="true"></i></div>
        {% endif %}
      </div>
      <span class="ed-spec__name" role="cell">{{ item.name | escape }}</span>
      <div class="ed-spec__make" role="cell">
        {%- if item.manufacturer and item.manufacturer != '' -%}
          <span class="ed-spec__vendor">{{ item.manufacturer | escape }}</span>
        {%- endif -%}
        {%- if item.model and item.model != '' -%}
          <code class="ed-spec__model-badge">{{ item.model | escape }}</code>
        {%- endif -%}
      </div>
      <div class="ed-spec__loc" role="cell">
        {%- if item.location and item.location != '' -%}
          <span class="ed-spec__loc-pill"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> {{ item.location | escape }}</span>
        {%- endif -%}
      </div>
    </div>
  {% endfor %}
</div>
