<div class="news-feed">
  <div class="news-feed__header">
    <h2 class="news-feed__title">
      <i class="fa-solid fa-bullhorn" aria-hidden="true"></i> <span data-i18n="home.news.title">최근 소식 (Latest News)</span>
    </h2>
    <a href="{{ '/news/' | relative_url }}" class="news-feed__all-link">
      <span data-i18n="home.news.all">전체 소식</span> <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
    </a>
  </div>

  {% assign news_items = site.news | sort: 'date' | reverse %}
  {% assign current_time = 'now' | date: '%s' %}

  <div class="news-feed__list">
    {% for item in news_items limit: 5 %}
      {% assign item_time = item.date | date: '%s' %}
      {% assign diff_seconds = current_time | minus: item_time %}
      <div class="news-feed-card{% if item.category %} news-feed-card--{{ item.category }}{% endif %}">
        <div class="news-feed-card__meta">
          <time class="news-feed-card__date" datetime="{{ item.date | date_to_xmlschema }}">
            {{ item.date | date: '%Y.%m.%d' }}
          </time>
          {% if diff_seconds < 2592000 and diff_seconds >= 0 %}
            <span class="news-badge-new">NEW</span>
          {% endif %}
          {% if item.category == 'award' %}
            <span class="news-cat-badge news-cat-badge--award"
              ><i class="fa-solid fa-trophy" aria-hidden="true"></i> <span data-i18n="news.cat_award">수상 (Award)</span></span
            >
          {% elsif item.category == 'member' %}
            <span class="news-cat-badge news-cat-badge--member"
              ><i class="fa-solid fa-user-graduate" aria-hidden="true"></i> <span data-i18n="news.cat_member">구성원 (Member)</span></span
            >
          {% elsif item.category == 'honor' %}
            <span class="news-cat-badge news-cat-badge--honor"
              ><i class="fa-solid fa-star" aria-hidden="true"></i> <span data-i18n="news.cat_honor">영예·선정 (Honor)</span></span
            >
          {% elsif item.category == 'milestone' %}
            <span class="news-cat-badge news-cat-badge--milestone"
              ><i class="fa-solid fa-flag-checkered" aria-hidden="true"></i> <span data-i18n="news.cat_milestone">주요 성과 (Milestone)</span></span
            >
          {% endif %}
        </div>
        <div class="news-feed-card__body">
          {% if item.inline %}
            <span data-news-lang="ko">{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}</span>
            {% if item.summary_en -%}
              <span data-news-lang="en">{{ item.summary_en }}</span>
            {%- endif %}
            {% if item.summary_ja -%}
              <span data-news-lang="ja">{{ item.summary_ja }}</span>
            {%- endif %}
            {% if item.summary_zh -%}
              <span data-news-lang="zh">{{ item.summary_zh }}</span>
            {%- endif %}
          {% else %}
            <a class="news-feed-card__link" href="{{ item.url | relative_url }}">{{ item.title }}</a>
          {% endif %}
        </div>
      </div>
    {% else %}
      <div class="news-feed-card">
        <div class="news-feed-card__body" style="color: var(--global-text-color-light);">No recent announcements.</div>
      </div>
    {% endfor %}
  </div>
</div>
