{% comment %}
  Co-PI executive profile: portrait + contact column, then identity,
  summary, career/education timelines, topics and profile links.
  Falls back to the long-form `bio` only when no `summary` is set.
{% endcomment %}
{% assign m = include.member %}
{% comment %}
  Summary keyword anchors: each term is wrapped as <span class="pi-kw pi-kw--{group}">.
  process = how it is made, material = what it is made of, device = what it is used for.
{% endcomment %}
{% assign kw_process = 'IPL|LIG|적층제조' | split: '|' %}
{% assign kw_material = '맥신|MOF|전극 소재|촉매' | split: '|' %}
{% assign kw_device = '슈퍼커패시터|슈퍼캐패시터|리튬이온전지|배터리|센서' | split: '|' %}
{% assign kw_groups = 'process|material|device' | split: '|' %}
{% assign member_email = m.links.email | default: m.email %}

<article class="pi-profile" id="member-{{ m.id }}" aria-labelledby="member-{{ m.id }}-name">
  <aside class="pi-profile__aside">
    <figure class="pi-profile__portrait">
      {% if m.photo and m.photo != '' %}
        <img
          src="{{ m.photo | relative_url }}"
          alt="{{ m.name_en }} ({{ m.name_ko }})"
          loading="lazy"
          decoding="async"
          style="object-position: {{ m.photo_position | default: 'center 20%' }};"
        >
      {% else %}
        {% assign name_parts = m.name_en | split: ' ' %}
        <span class="pi-profile__monogram" aria-hidden="true">
          {{- name_parts.first | slice: 0, 1 -}}
          {{- name_parts.last | slice: 0, 1 -}}
        </span>
      {% endif %}
    </figure>

    <dl class="pi-contact">
      {% if m.office and m.office != '' %}
        {% assign office_parts = m.office | split: ' (' %}
        <div class="pi-contact__row">
          <dt class="pi-contact__icon pi-contact__icon--office">
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i><span class="tm-sr-only">Office</span>
          </dt>
          <dd>
            {{ office_parts[0] }}
            {% if office_parts.size > 1 %}
              <span class="pi-contact__sub">{{ office_parts[1] | replace: ')', '' }}</span>
            {% endif %}
          </dd>
        </div>
      {% endif %}
      {% if m.phone and m.phone != '' %}
        <div class="pi-contact__row">
          <dt class="pi-contact__icon pi-contact__icon--phone">
            <i class="fa-solid fa-phone" aria-hidden="true"></i><span class="tm-sr-only">Phone</span>
          </dt>
          <dd>
            <a href="tel:{{ m.phone | remove: '-' }}">{{ m.phone }}</a>
          </dd>
        </div>
      {% endif %}
      {% if member_email and member_email != '' %}
        <div class="pi-contact__row">
          <dt class="pi-contact__icon pi-contact__icon--email">
            <i class="fa-solid fa-envelope" aria-hidden="true"></i><span class="tm-sr-only">Email</span>
          </dt>
          <dd>
            <a href="mailto:{{ member_email }}">{{ member_email }}</a>
          </dd>
        </div>
      {% endif %}
    </dl>
  </aside>

  <div class="pi-profile__main">
    <header class="pi-profile__header">
      {% if m.role_en %}
        <p class="pi-profile__eyebrow">
          <i class="fa-solid fa-user-tie" aria-hidden="true"></i><span data-i18n="home.copi.role_tag">{{ m.role_en }}</span>
        </p>
      {% endif %}
      <h3 class="pi-profile__name" id="member-{{ m.id }}-name">
        {{ m.name_ko }}
        <span class="pi-profile__name-en" lang="en">{{ m.name_en }}</span>
      </h3>
      <p class="pi-profile__title">
        <span data-i18n-term>{{ m.title_ko -}}</span>
        <span class="pi-profile__sep" aria-hidden="true">|</span><span lang="en">{{ m.title_en }}</span>
      </p>
      {% if m.affiliation_ko %}
        <p class="pi-profile__affil" data-i18n-term>{{ m.affiliation_ko }}</p>
      {% endif %}
    </header>

    {% assign summary_text = m.summary | default: m.bio %}
    {% if summary_text and summary_text != '' %}
      {% assign summary_html = summary_text | escape %}
      {% for group in kw_groups %}
        {% case group %}
          {% when 'process' -%}
            {%- assign kws = kw_process %}
          {% when 'material' -%}
            {%- assign kws = kw_material %}
          {% else -%}
            {%- assign kws = kw_device %}
        {% endcase %}
        {% for kw in kws %}
          {% capture wrapped %}<span class="pi-kw pi-kw--{{ group }}">{{ kw }}</span>{% endcapture %}
          {% assign summary_html = summary_html | replace: kw, wrapped %}
        {% endfor %}
      {% endfor %}
      <p
        class="pi-profile__summary"
        data-i18n-mode="html"
        data-i18n-ko="{{ summary_html | escape }}"
        data-i18n-en="{{ m.summary_i18n.en | escape }}"
        data-i18n-ja="{{ m.summary_i18n.ja | escape }}"
        data-i18n-zh="{{ m.summary_i18n.zh | escape }}"
      >
        {{ summary_html }}
      </p>
    {% endif %}

    {% if m.career or m.degrees %}
      <div class="pi-profile__history">
        {% if m.career %}
          <section class="pi-history" aria-label="Career">
            <h4 class="pi-profile__label" data-i18n="pi.section.career">Career</h4>
            <ol class="pi-timeline">
              {% for c in m.career %}
                {% assign is_current = false -%}
                {%- if c.period contains '현재' %}{% assign is_current = true %}{% endif %}
                {% assign sector_key = c.kind | default: 'academia' %}
                {% if is_current %}{% assign sector_key = 'current' %}{% endif %}
                <li class="pi-timeline__item pi-timeline__item--{{ sector_key }}{% if is_current %} is-current{% endif %}{% if c.brand %} pi-timeline__item--brand-{{ c.brand }}{% endif %}">
                  <span class="pi-timeline__period">
                    <span data-i18n-term>{{- c.period -}}</span>
                    {%- if is_current -%}
                      <span class="pi-timeline__badge" data-i18n="pi.current_badge">현재 재직 · Current</span>
                    {%- endif -%}
                  </span>
                  <span class="pi-timeline__org" data-i18n-term>{{ c.org }}</span>
                  <span class="pi-timeline__role" data-i18n-term>{{ c.role }}</span>
                  {% if c.note -%}
                    <span class="pi-timeline__note"
                      ><i class="fa-solid fa-tag" aria-hidden="true"></i><span data-i18n-term>{{ c.note }}</span></span
                    >
                  {%- endif %}
                </li>
              {% endfor %}
            </ol>
          </section>
        {% endif %}
        {% if m.degrees %}
          <section class="pi-history" aria-label="Education">
            <h4 class="pi-profile__label" data-i18n="pi.section.education">Education</h4>
            <ol class="pi-timeline">
              {% for d in m.degrees %}
                <li class="pi-timeline__item pi-timeline__item--{{ d.kind | default: 'academia' }}{% if d.brand %} pi-timeline__item--brand-{{ d.brand }}{% endif %}">
                  <span class="pi-timeline__period" data-i18n-term>{{ d.period }}</span>
                  <span class="pi-timeline__org" data-i18n-term>{{ d.org }}</span>
                  <span class="pi-timeline__role" data-i18n-term>{{ d.role }}</span>
                  {% if d.note -%}
                    <span class="pi-timeline__note"
                      ><i class="fa-solid fa-tag" aria-hidden="true"></i><span data-i18n-term>{{ d.note }}</span></span
                    >
                  {%- endif %}
                </li>
              {% endfor %}
            </ol>
          </section>
        {% endif %}
      </div>
    {% endif %}

    {% if m.topics and m.topics.size > 0 %}
      <div class="pi-profile__block">
        <h4 class="pi-profile__label" data-i18n="pi.section.topics">Research Topics</h4>
        <ul class="pi-topics" role="list">
          {% for t in m.topics %}
            <li class="topic-tag">{{ t }}</li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    {% if m.teaching and m.teaching.size > 0 %}
      <section class="pi-profile__block pi-teaching" aria-label="Teaching">
        <div class="pi-teaching__head">
          <h4 class="pi-profile__label" data-i18n="pi.section.teaching">Teaching</h4>
          <p class="pi-teaching__legend" aria-hidden="true">
            <span data-i18n="pi.teaching.legend1">(학점) · 시수</span>
            <span class="pi-teaching__legend-sep">/</span>
            <span data-i18n="pi.teaching.legend2">강의평가 (5.0 만점)</span>
          </p>
        </div>
        <div class="pi-teaching__list">
          {% for y in m.teaching %}
            <div class="pi-teaching__year">
              <div class="pi-teaching__year-label">{{ y.year }}</div>
              {% if y.note %}
                <div class="pi-teaching__sabbatical">
                  <i class="fa-solid fa-compass" aria-hidden="true"></i>
                  <span data-i18n-term>{{ y.note }}</span>
                </div>
              {% elsif y.semesters %}
                <div class="pi-teaching__semesters">
                  {% for s in y.semesters %}
                    <div class="pi-teaching__sem">
                      <div class="pi-teaching__sem-head">
                        <span class="pi-teaching__term">
                          {{- y.year }}
                          {{ s.term -}}
                        </span>
                        {% if s.credits %}
                          <span class="pi-teaching__credits" data-i18n-term>{{ s.credits }}</span>
                        {% endif %}
                      </div>
                      <ul class="pi-course-list" role="list">
                        {% for c in s.courses %}
                          {% assign is_grad = false %}
                          {% if c.level contains '대학원' %}{% assign is_grad = true %}{% endif %}
                          <li class="pi-course">
                            <span class="pi-course__level{% if is_grad %} pi-course__level--grad{% endif %}" data-i18n-term>{{ c.level }}</span>
                            <span class="pi-course__title">
                              <span data-i18n-term>{{- c.title -}}</span>
                              {%- if c.advisees %}
                                <span class="pi-course__advisees">({{ c.advisees }})</span>
                              {%- endif -%}
                              {%- if c.credits %}
                                <span class="pi-course__unit"
                                  >(<span data-i18n-term>{{ c.credits }}</span>)</span
                                >
                              {%- endif -%}
                            </span>
                            {% if c.lang or c.eval %}
                              <span class="pi-course__meta">
                                {%- if c.lang -%}
                                  <span class="pi-course__lang">{{ c.lang }}</span>
                                {%- endif -%}
                                {%- if c.eval -%}
                                  <span class="pi-course__eval{% if c.eval == 'N.A.' %} pi-course__eval--na{% endif %}">{{ c.eval }}</span>
                                {%- endif -%}
                              </span>
                            {% endif %}
                          </li>
                        {% endfor %}
                      </ul>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if m.links.scholar or m.links.orcid or m.links.researchgate or m.links.github %}
      <nav class="pi-actions" aria-label="{{ m.name_en }} academic profiles">
        {% if m.links.scholar and m.links.scholar != '' %}
          <a class="pi-action" href="{{ m.links.scholar }}" target="_blank" rel="noopener"
            ><i class="ai ai-google-scholar" aria-hidden="true"></i>Google Scholar</a
          >
        {% endif %}
        {% if m.links.orcid and m.links.orcid != '' %}
          <a class="pi-action" href="{{ m.links.orcid }}" target="_blank" rel="noopener"><i class="ai ai-orcid" aria-hidden="true"></i>ORCID</a>
        {% endif %}
        {% if m.links.researchgate and m.links.researchgate != '' %}
          <a class="pi-action" href="{{ m.links.researchgate }}" target="_blank" rel="noopener"
            ><i class="ai ai-researchgate" aria-hidden="true"></i>ResearchGate</a
          >
        {% endif %}
        {% if m.links.github and m.links.github != '' %}
          <a class="pi-action" href="{{ m.links.github }}" target="_blank" rel="noopener"
            ><i class="fa-brands fa-github" aria-hidden="true"></i>GitHub</a
          >
        {% endif %}
      </nav>
    {% endif %}
  </div>
</article>
