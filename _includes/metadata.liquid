{% if site.enable_google_verification or site.google_site_verification %}
  <meta name="google-site-verification" content="{{ site.google_site_verification }}">
  <meta http-equiv="Permissions-Policy" content="interest-cohort=()">
{% endif %}
{% if site.enable_bing_verification %}
  <meta name="msvalidate.01" content="{{ site.bing_site_verification }}">
{% endif %}
<meta name="naver-site-verification" content="66b28497109cdd5d5ff2d8b1f71c08c7">

{% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}

<!-- Standard metadata -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">

<!-- SEO title/description SSOT: shared by <title>, og:*, twitter:* and meta description -->
{% capture seo_title -%}
  {%- if page.url == '/' or page.url == '/index.html' -%}
    경북대학교 에너지화학공학과 ACE² Lab | 차세대 화학 및 에너지 공학 연구실 (임창용·김태욱 교수)
  {%- elsif page.url contains '/members' -%}
    연구실 구성원 | 임창용·김태욱 교수 | 경북대학교 에너지화학공학과 ACE² Lab
  {%- elsif page.url contains '/publications' -%}
    연구성과 (SCI 논문·특허) | 임창용·김태욱 교수 | 경북대학교 에너지화학공학과 ACE² Lab
  {%- elsif page.url contains '/chem-frontier' -%}
    Chem Frontier(켐프론티어) 3년 연속 최고상 (장관상·대상) | 한국화학공학회 창의설계 경진대회 | 경북대학교 에너지화학공학과 ACE² Lab
  {%- elsif page.url contains '/facilities' -%}
    연구 장비 및 실험 인프라 | 경북대학교 에너지화학공학과 ACE² Lab
  {%- elsif page.url contains '/news' -%}
    수상 실적 및 연구실 소식 | Chem Frontier(켐프론티어) 장관상·대상 3년 연속 석권 | 경북대학교 에너지화학공학과 ACE² Lab
  {%- elsif page.url contains '/research' -%}
    화학공학·에너지공학 핵심 연구분야 (이차전지·광소결·유연센서) | 경북대학교 에너지화학공학과 ACE² Lab
  {%- elsif page.url contains '/gallery' -%}
    연구실 갤러리 | 학술대회 및 연구 활동 | 경북대학교 에너지화학공학과 ACE² Lab
  {%- elsif page.url contains '/teaching' -%}
    강의 및 화학공학 시뮬레이션 | 경북대학교 에너지화학공학과 ACE² Lab
  {%- elsif page.title and page.title != 'blank' and page.title != '' -%}
    {{ page.title }} | ACE² Lab | 경북대학교 에너지화학공학과
  {%- else -%}
    ACE² Lab | 경북대학교 에너지화학공학과
  {%- endif -%}
{%- endcapture %}
{% assign seo_title = seo_title | strip %}
{% assign seo_description = page.description | default: site.description | strip | escape %}
<title>{{ seo_title }}</title>

<meta name="author" content="ACE² Lab | 임창용 · 김태욱 (Changyong Yim, Taewook Kim)">
<meta name="description" content="{{ seo_description }}">
{% if page.keywords or site.keywords %}
  <meta name="keywords" content="{% if page.keywords %}{{ page.keywords }}{% else %}{{ site.keywords }}{% endif %}">
{% endif %}

{% assign is_blog_post = false %}
{% if page.url != '/blog/index.html' and page.url contains '/blog/' %}
  {% unless page.url contains '/tag/' or page.url contains '/category/' %}
    {% assign is_blog_post = true %}
  {% endunless %}
{% endif %}

{% if site.serve_og_meta %}
  <!-- OpenGraph -->
  <meta property="og:site_name" content="경북대학교 에너지화학공학과 ACE² Lab">
  <meta property="og:type" content="{% if is_blog_post %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ seo_title }}">
  <meta property="og:url" content="{{ page.url | prepend: site.baseurl | prepend: site.url | remove_first: 'index.html' }}">
  <meta property="og:description" content="{{ seo_description }}">
  {% if page.og_image or site.og_image %}
    {% assign og_image_source = page.og_image | default: site.og_image %}
    {% if og_image_source contains '://' %}
      {% assign og_image_url = og_image_source %}
    {% else %}
      {% assign og_image_norm = og_image_source | prepend: '/' | replace: '//', '/' %}
      {% assign og_image_url = og_image_norm | prepend: site.baseurl | prepend: site.url %}
    {% endif %}
    <meta property="og:image" content="{{ og_image_url }}">
  {% endif %}
  <meta property="og:locale" content="{{ site.lang | default: 'ko' }}">

  <!-- Twitter card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ seo_title }}">
  <meta name="twitter:description" content="{{ seo_description }}">
  {% if og_image_url %}
    <meta name="twitter:image" content="{{ og_image_url }}">
  {% endif %}
{% endif %}

