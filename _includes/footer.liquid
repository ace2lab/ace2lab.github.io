<footer class="{% if site.footer_fixed %}fixed-bottom{% else %}site-footer{% endif %}" role="contentinfo">
  <div class="container text-center">
    <div class="footer-lab-name" data-i18n="footer.lab_name">Advanced Chemical &amp; Energy Engineering Laboratory (ACE² Lab)</div>
    <div class="footer-affiliation" data-i18n="footer.affiliation">
      Department of Energy Chemical Engineering, College of Science and Technology, Kyungpook National University
    </div>
    <div class="footer-location" data-i18n="footer.location">
      Department of Energy Chemical Engineering, 4th Fl., Bldg. 7, Kyungpook National University, 2559 Gyeongsang-daero, Sangju-si, Gyeongsangbuk-do
      37224, Republic of Korea
    </div>
    <div class="footer-meta">
      <span class="footer-copyright" data-i18n="footer.copyright"> &copy; {{ 'now' | date: '%Y' }} ACE² Lab. Hosted on GitHub Pages. </span>
      {% if site.impressum_path %}
        <span class="footer-divider">&middot;</span>
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>
      {% endif %}
      {% if site.last_updated %}
        <span class="footer-divider">&middot;</span>
        <span class="footer-updated">Last updated: {{ 'now' | date: '%B %d, %Y' }}</span>
      {% endif %}
      {% assign gc_code = site.goatcounter.code | strip %}
      {% if gc_code != '' %}
        <span id="ace2-visitor-wrap" class="footer-visitors" hidden>
          <span class="footer-divider" aria-hidden="true">&middot;</span>
          <span data-i18n="footer.visitors">Views</span>
          <span id="ace2-visitor-count" class="footer-visitors__num"></span>
        </span>
      {% endif %}
    </div>
  </div>
  {% if gc_code != '' %}
    <script
      id="ace2-gc-script"
      data-goatcounter="https://{{ gc_code | escape }}.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"
    ></script>
    <script>
      (function () {
        var gcCode = {{ gc_code | jsonify }};
        var minShow = {{ site.goatcounter.min_display | default: 0 | plus: 0 }};
        var loaded = false;

        function renderCount(num) {
          if (typeof num !== "number" || isNaN(num) || num <= 0 || num < minShow) return;
          var numEl = document.getElementById("ace2-visitor-count");
          var wrapEl = document.getElementById("ace2-visitor-wrap");
          if (numEl && wrapEl) {
            numEl.textContent = num.toLocaleString();
            wrapEl.hidden = false;
          }
        }

        function parseCount(d) {
          if (!d || d.count === undefined || d.count === null) return 0;
          var raw = String(d.count).replace(/[^0-9]/g, "");
          var num = raw ? parseInt(raw, 10) : 0;
          return isNaN(num) ? 0 : num;
        }

        function fetchTotal() {
          if (loaded) return;
          loaded = true;
          var base = "https://" + encodeURIComponent(gcCode) + ".goatcounter.com/counter/";
          fetch(base + "TOTAL.json")
            .then(function (r) {
              return r.ok ? r.json() : null;
            })
            .then(function (d) {
              var count = parseCount(d);
              if (count > 0) {
                renderCount(count);
                return;
              }
              fetch(base + "%2F.json")
                .then(function (r2) {
                  return r2.ok ? r2.json() : null;
                })
                .then(function (d2) {
                  var count2 = parseCount(d2);
                  if (count2 > 0) renderCount(count2);
                })
                .catch(function () {});
            })
            .catch(function () {
              fetch(base + "%2F.json")
                .then(function (r2) {
                  return r2.ok ? r2.json() : null;
                })
                .then(function (d2) {
                  var count2 = parseCount(d2);
                  if (count2 > 0) renderCount(count2);
                })
                .catch(function () {});
            });
        }

        var s = document.getElementById("ace2-gc-script");
        if (s) s.addEventListener("load", function () { setTimeout(fetchTotal, 150); });
        setTimeout(fetchTotal, 1200);
      })();
    </script>
  {% endif %}
</footer>
