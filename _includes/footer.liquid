<footer class="{% if site.footer_fixed %}fixed-bottom{% else %}site-footer{% endif %}" role="contentinfo">
  <div class="container text-center">
    <div class="footer-lab-name" data-i18n="footer.lab_name">Advanced Chemical &amp; Energy Engineering Laboratory (ACE² Lab)</div>
    <div class="footer-affiliation" data-i18n="footer.affiliation">
      Department of Energy Chemical Engineering, College of Science and Technology, Kyungpook National University
    </div>
    <div class="footer-location" data-i18n="footer.location">
      Engineering Bldg 7, Rms 403 &amp; 414, 80 Daehak-ro, Buk-gu, Daegu 41566, Republic of Korea
    </div>
    <div class="footer-meta">
      <span class="footer-copyright" data-i18n="footer.copyright"> &copy; {{ 'now' | date: '%Y' }} ACE² Lab. Hosted on GitHub Pages. </span>
      {% if site.impressum_path %}
        <span class="footer-divider">&middot;</span>
        <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>
      {% endif %}
      {% if site.last_updated %}
        <span class="footer-divider">&middot;</span>
        <span class="footer-updated">Last updated: {{ 'now' | date: '%B %d, %Y' }}</span>
      {% endif %}
    </div>
  </div>
</footer>
