{% assign a = include.alumni %}

<div class="alumni-row" id="{{ a.id }}">
  <div class="alumni-row__avatar-wrapper">
    {% if a.photo and a.photo != '' %}
      <img src="{{ a.photo | relative_url }}" alt="{{ a.name_en }}" class="alumni-row__avatar" loading="lazy" decoding="async">
    {% else %}
      {% assign name_parts = a.name_en | split: ' ' %}
      <div class="alumni-row__avatar alumni-row__avatar--placeholder" aria-hidden="true">
        <span>
          {{- name_parts.first | slice: 0, 1 -}}
          {{- name_parts.last | slice: 0, 1 -}}
        </span>
      </div>
    {% endif %}
  </div>

  <div class="alumni-row__body">
    <div class="alumni-row__left">
      <span class="alumni-row__degree">{{ a.degree }} · {{ a.grad_year }}</span>
      <span class="alumni-row__name">
        {{- a.name_ko -}}
        <span class="alumni-row__name-en">{{ a.name_en }}</span></span
      >
    </div>
    <div class="alumni-row__thesis">
      {% if a.thesis and a.thesis != '' -%}
        <em>{{ a.thesis }}</em>
      {%- endif %}
    </div>
    <div class="alumni-row__now">
      <span class="alumni-row__arrow" aria-hidden="true">→</span>
      <span class="alumni-row__dest">
        {% if a.now.url and a.now.url != '' %}
          <a href="{{ a.now.url }}" target="_blank" rel="noopener">{{ a.now.affiliation }}</a>
        {% else %}
          {{ a.now.affiliation }}
        {% endif %}
        {% if a.now.position and a.now.position != '' %}
          <span class="alumni-row__position">{{ a.now.position }}</span>
        {% endif %}
      </span>
    </div>
  </div>
</div>
