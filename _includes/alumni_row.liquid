{% assign a = include.alumni %}
{% assign ach_papers = site.data.student_papers | where_exp: 'x', 'x.members contains a.name_ko' %}
{% assign ach_patents = site.data.patents | where_exp: 'x', 'x.inventors contains a.name_ko' %}
{% assign ach_awards = site.data.awards | where_exp: 'x', 'x.recipient contains a.name_ko' %}
{% assign ach_talks = site.data.talks | where_exp: 'x', 'x.members contains a.name_ko' %}
{% assign ach_total = ach_papers.size | plus: ach_patents.size | plus: ach_awards.size | plus: ach_talks.size %}

<div class="alumni-row" id="{{ a.id }}">
  <div class="alumni-row__avatar-wrapper">
    {% if a.photo and a.photo != '' %}
      <img src="{{ a.photo | relative_url }}" alt="{{ a.name_en }}" class="alumni-row__avatar" loading="lazy" decoding="async">
    {% else %}
      {% assign name_parts = a.name_en | split: ' ' %}
      <div class="alumni-row__avatar alumni-row__avatar--placeholder" aria-hidden="true">
        <span>
          {{- name_parts.first | slice: 0, 1 -}}
          {{- name_parts.last | slice: 0, 1 -}}
        </span>
      </div>
    {% endif %}
  </div>

  <div class="alumni-row__body">
    <div class="alumni-row__left">
      <span class="alumni-row__degree">
        {{- a.degree -}}
        {%- if a.joint_inst %} (학연){% endif %} · {{ a.grad_year -}}
      </span>
      <span class="alumni-row__name">
        {{- a.name_ko -}}
        <span class="alumni-row__name-en">{{ a.name_en }}</span></span
      >
      {% if a.dept or a.joint_inst %}
        <span class="alumni-row__meta">
          {% if a.dept -%}
            <span class="alumni-row__dept" data-i18n-term>{{ a.dept }}</span>
          {%- endif %}
          {% if a.joint_inst %}
            <span class="alumni-row__joint" data-i18n-term> · {{ a.joint_inst }}</span>
          {% endif %}
        </span>
      {% endif %}
    </div>
    <div class="alumni-row__thesis">
      {% if a.thesis and a.thesis != '' -%}
        <div class="alumni-row__thesis-title">
          <em data-i18n-term>{{ a.thesis }}</em>
        </div>
      {%- endif %}
      {% if ach_total > 0 %}
        <div class="alumni-row__ach-wrap">
          <button
            type="button"
            class="member-card__ach-btn alumni-row__ach-btn"
            data-ach-target="ach-{{ a.id }}"
            data-ach-name="{{ a.name_ko | escape }}"
            data-ach-name-en="{{ a.name_en | escape }}"
            aria-haspopup="dialog"
            aria-label="{{ a.name_ko }} 연구 실적 {{ ach_total }}건 보기"
          >
            <i class="fa-solid fa-award" aria-hidden="true"></i><span data-i18n-term>연구 실적 · {{ ach_total }}</span>
          </button>
        </div>
      {% endif %}
    </div>
    <div class="alumni-row__now">
      <span class="alumni-row__arrow" aria-hidden="true">→</span>
      <span class="alumni-row__dest">
        {% assign aff_term = site.data.i18n.terms[a.now.affiliation] %}
        {% if a.now.url and a.now.url != '' %}
          <a href="{{ a.now.url }}" target="_blank" rel="noopener" data-i18n-term data-orig-term="{{ a.now.affiliation | escape }}">
            {{- aff_term.ko | default: a.now.affiliation -}}
          </a>
        {% else %}
          <span data-i18n-term data-orig-term="{{ a.now.affiliation | escape }}">{{ aff_term.ko | default: a.now.affiliation }}</span>
        {% endif %}
        {% if a.now.position and a.now.position != '' %}
          {% assign pos_term = site.data.i18n.terms[a.now.position] %}
          <span class="alumni-row__position" data-i18n-term data-orig-term="{{ a.now.position | escape }}">
            {{- pos_term.ko | default: a.now.position -}}
          </span>
        {% endif %}
      </span>
    </div>
  </div>
</div>
